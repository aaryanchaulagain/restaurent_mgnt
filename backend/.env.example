APP_NAME=Suvakamana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suvakamana_restaurant
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@suvakamana.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Super-admin MFA (keep true in production). Set false for local development only.
SUVAKAMANA_REQUIRE_SUPER_ADMIN_MFA=true

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
SEED_RESTAURANT_OWNER_EMAIL=owner@example.com
SEED_RESTAURANT_OWNER_PASSWORD=
SEED_RESTAURANT_MANAGER_EMAIL=manager@example.com
SEED_RESTAURANT_MANAGER_PASSWORD=
SEED_RESTAURANT_STAFF_EMAIL=staff@example.com
SEED_RESTAURANT_STAFF_PASSWORD=

PARTNER_TERMS_VERSION=2026-07-01
PARTNER_DEFAULT_COMMISSION_RATE=12.50
PARTNER_APPLICATION_EXPIRY_DAYS=90
PARTNER_MAX_DOCUMENT_BYTES=5242880
RESTAURANT_DEFAULT_CURRENCY=AUD
RESTAURANT_DEFAULT_TIMEZONE=Australia/Sydney

# Optional later phases — leave empty for Phase 1
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Stripe / payments (Phase 6)
PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=AUD
STRIPE_CONNECT_CHARGE_STRATEGY=destination_charge
STRIPE_PLATFORM_COUNTRY=AU
STRIPE_API_VERSION=2024-11-20.acacia
STRIPE_ONBOARDING_RETURN_URL=http://localhost:3000/restaurant/settings/payments/return
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:3000/restaurant/settings/payments/refresh
PAYMENT_PENDING_EXPIRY_MINUTES=30
PAYMENT_MAX_RETRY_ATTEMPTS=5
PAYMENT_WEBHOOK_MAX_RETRIES=10

# Legacy aliases (unused by payments config — prefer STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY)
STRIPE_KEY=
STRIPE_SECRET=

UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=

SUVAKAMANA_RESTAURANT_NAME="Suvakamana Restaurant"
SUVAKAMANA_RESTAURANT_SLUG=suvakamana-restaurant
SUVAKAMANA_RESTAURANT_EMAIL=
SUVAKAMANA_RESTAURANT_PHONE=
SUVAKAMANA_RESTAURANT_TIMEZONE=Australia/Sydney
SUVAKAMANA_RESTAURANT_CURRENCY=AUD

ORDER_ACCEPTANCE_TIMEOUT_MINUTES=10
CHECKOUT_QUOTE_EXPIRY_MINUTES=15

VITE_APP_NAME="${APP_NAME}"
