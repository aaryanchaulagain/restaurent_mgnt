# =============================================================================
# Suvakamana backend environment template
# Placeholders only — never commit real secrets.
# Legend: [mandatory] [optional] [production] [local] [secret] [public-adjacent]
# =============================================================================

# --- Application ---
APP_NAME=Suvakamana                          # mandatory
APP_ENV=local                                # mandatory (local|staging|production)
APP_KEY=                                     # mandatory, secret — php artisan key:generate
APP_DEBUG=true                               # mandatory; MUST be false in production
APP_URL=http://localhost:8000                # mandatory; HTTPS required in production
APP_VERSION=v1                               # optional — safe public build identifier

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Frontend / API URLs ---
FRONTEND_URL=http://localhost:3000           # mandatory — Sanctum stateful + CORS allowlist
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000  # mandatory

# --- Logging ---
LOG_CHANNEL=stack                            # mandatory
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                              # production: info or warning
# Retain/rotate application logs via host logrotate (e.g. 14–30 days).

# --- Database ---
DB_CONNECTION=mysql                          # mandatory
DB_HOST=127.0.0.1                            # mandatory, secret-adjacent
DB_PORT=3306
DB_DATABASE=suvakamana_restaurant            # mandatory
DB_USERNAME=root                             # mandatory
DB_PASSWORD=                                 # mandatory in prod, secret

# --- Cache ---
CACHE_STORE=file                             # production: redis recommended

# --- Sessions / cookies ---
SESSION_DRIVER=file                          # production: redis or database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null                          # production: your cookie domain
SESSION_SECURE_COOKIE=null                   # production: true behind HTTPS
SESSION_SAME_SITE=lax                        # production: lax or strict as needed

# --- Queues ---
QUEUE_CONNECTION=sync                        # local only; production: redis|database|sqs
# Failed jobs use database-uuids by default (queue.failed).

# --- Redis (optional locally; recommended production for cache/queue/session) ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null                          # secret when set
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log                              # local: log|array; production: smtp|ses|postmark|etc
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null                           # secret when set
MAIL_PASSWORD=null                           # secret
MAIL_FROM_ADDRESS="noreply@example.com"      # mandatory for real delivery
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem / media ---
FILESYSTEM_DISK=local                        # production: s3 (or equivalent) if redeploys wipe disk
# Public menu/logo media → public disk; partner onboarding docs → private disk only.
# Run: php artisan storage:link

# --- Object storage (optional / production) ---
AWS_ACCESS_KEY_ID=                           # secret
AWS_SECRET_ACCESS_KEY=                       # secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Security / proxies ---
TRUSTED_PROXIES=                             # production behind TLS terminator: * or CIDR list
SUVAKAMANA_REQUIRE_SUPER_ADMIN_MFA=true      # keep true in production
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# --- Payment providers (secret) ---
PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=                           # secret — required when card payments enabled
STRIPE_PUBLISHABLE_KEY=                      # public-adjacent (also used as NEXT_PUBLIC on frontend)
STRIPE_WEBHOOK_SECRET=                       # secret — required when Stripe secret is set
STRIPE_CURRENCY=AUD
STRIPE_CONNECT_CHARGE_STRATEGY=destination_charge
STRIPE_PLATFORM_COUNTRY=AU
STRIPE_API_VERSION=2024-11-20.acacia
STRIPE_ONBOARDING_RETURN_URL=http://localhost:3000/restaurant/settings/payments/return
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:3000/restaurant/settings/payments/refresh
PAYMENT_PENDING_EXPIRY_MINUTES=30
PAYMENT_MAX_RETRY_ATTEMPTS=5
PAYMENT_WEBHOOK_MAX_RETRIES=10

# Legacy unused aliases — prefer STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY
STRIPE_KEY=
STRIPE_SECRET=

# --- Delivery integrations (optional; not required for Phase 7A) ---
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=                   # secret

# --- Partner / restaurant defaults ---
PARTNER_TERMS_VERSION=2026-07-01
PARTNER_DEFAULT_COMMISSION_RATE=12.50
PARTNER_APPLICATION_EXPIRY_DAYS=90
PARTNER_MAX_DOCUMENT_BYTES=5242880
RESTAURANT_DEFAULT_CURRENCY=AUD
RESTAURANT_DEFAULT_TIMEZONE=Australia/Sydney

ORDER_ACCEPTANCE_TIMEOUT_MINUTES=10
CHECKOUT_QUOTE_EXPIRY_MINUTES=15

# --- Local / demo seed settings (local-only; leave passwords empty in production) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=                   # secret, local-only
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
SEED_RESTAURANT_OWNER_EMAIL=owner@example.com
SEED_RESTAURANT_OWNER_PASSWORD=
SEED_RESTAURANT_MANAGER_EMAIL=manager@example.com
SEED_RESTAURANT_MANAGER_PASSWORD=
SEED_RESTAURANT_STAFF_EMAIL=staff@example.com
SEED_RESTAURANT_STAFF_PASSWORD=

SUVAKAMANA_RESTAURANT_NAME="Suvakamana Restaurant"
SUVAKAMANA_RESTAURANT_SLUG=suvakamana-restaurant
SUVAKAMANA_RESTAURANT_EMAIL=
SUVAKAMANA_RESTAURANT_PHONE=
SUVAKAMANA_RESTAURANT_TIMEZONE=Australia/Sydney
SUVAKAMANA_RESTAURANT_CURRENCY=AUD

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
