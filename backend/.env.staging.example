# =============================================================================
# Staging backend environment template — placeholders only. DO NOT COMMIT REAL SECRETS.
# Copy to a secrets manager / host .env (never into git).
# Must differ from production: DB, Redis DB/prefix, APP_KEY, Stripe test keys, mail, URLs.
# =============================================================================

# --- Application (mandatory) ---
APP_NAME=SuvakamanaStaging
APP_ENV=staging                          # mandatory; staging-only
APP_KEY=                                 # mandatory, secret — generate uniquely for staging
APP_DEBUG=false                          # mandatory — must be false
APP_URL=https://api-staging.example.com  # mandatory HTTPS
APP_VERSION=staging
APP_RELEASE_SHA=                         # set to Git commit SHA at deploy time (public-safe)

# --- Frontend / CORS (mandatory; must be staging host) ---
FRONTEND_URL=https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=staging.example.com,api-staging.example.com

# --- Database (mandatory; SEPARATE from production) ---
DB_CONNECTION=pgsql
DB_HOST=staging-db.internal
DB_PORT=5432
DB_DATABASE=suvakamana_staging
DB_USERNAME=suvakamana_staging
DB_PASSWORD=                             # secret

# --- Cache / session / queue (staging isolation) ---
CACHE_STORE=redis
CACHE_PREFIX=suvakamana-staging-cache-
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.example.com
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=staging-redis.internal
REDIS_PASSWORD=                          # secret when set
REDIS_PORT=6379
REDIS_DB=2                               # staging-only DB index (not production 0)
REDIS_PREFIX=suvakamana-staging-

# --- Mail (sandbox only — never production customer lists) ---
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=                           # secret
MAIL_PASSWORD=                           # secret
MAIL_FROM_ADDRESS=noreply-staging@example.com
MAIL_FROM_NAME="Suvakamana Staging"

# --- Filesystem ---
FILESYSTEM_DISK=local                    # or s3 with staging bucket/prefix
# AWS_* with staging bucket/prefix only when using object storage

# --- Security ---
TRUSTED_PROXIES=*
SUVAKAMANA_REQUIRE_SUPER_ADMIN_MFA=true

# --- Payments: TEST MODE ONLY (secret) ---
PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me      # secret — test mode only (never live keys)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_test_replace # secret — staging webhook endpoint only
STRIPE_CURRENCY=AUD
STRIPE_ONBOARDING_RETURN_URL=https://staging.example.com/restaurant/settings/payments/return
STRIPE_ONBOARDING_REFRESH_URL=https://staging.example.com/restaurant/settings/payments/refresh

# --- Optional staging admin for staging:seed-minimal --with-admin ---
STAGING_ADMIN_EMAIL=staging-admin@example.com
STAGING_ADMIN_PASSWORD=                  # secret — leave empty unless seeding

# --- Do NOT set production seed passwords ---
SEED_SUPER_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_RESTAURANT_OWNER_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=info
