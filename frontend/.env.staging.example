# =============================================================================
# Staging frontend environment — placeholders only. Never commit secrets.
# NEVER put Stripe secrets, DB passwords, or webhook secrets in NEXT_PUBLIC_*.
# =============================================================================

# Public (browser-exposed) — staging API only
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_PARTNER_TERMS_VERSION=2026-07-01
NEXT_PUBLIC_REQUIRE_SUPER_ADMIN_MFA=true
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
NEXT_PUBLIC_APP_VERSION=staging
NEXT_PUBLIC_APP_RELEASE_SHA=             # short Git SHA at build time (optional)

# Server-only rewrite origin for Next (not NEXT_PUBLIC)
BACKEND_ORIGIN=https://api-staging.example.com
